function AbilityService.ReturnAbilities()
	local List = {}
	for Name, _ in pairs(Abilities) do
		List[Name] = false
	end
	return List
end

function AbilityService.ReturnAbilityInfo(AbilityName)
	return Abilities[AbilityName]
end

function AbilityService.GetAbilitiesFolder()
	local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not PlayerGui then return end

	local MainGui = PlayerGui:FindFirstChild("MainGui")
	if not MainGui then return end

	local AbilitiesGui = MainGui:FindFirstChild("Abilities")
	if not AbilitiesGui then return end
		
	return AbilitiesGui:FindFirstChild("Folder")
end

function AbilityService.GetAbilityButton(AbilityName)
	local Folder = AbilityService.GetAbilitiesFolder()
	if not Folder then
		return
	end
	return Folder:FindFirstChild(AbilityName)
end

function AbilityService.IsAbilityOnCooldown(Button)
	if not Button then
		return true
	end

	local CooldownLabel = Button:FindFirstChild("CooldownLabel")
	if not CooldownLabel then
		return false
	end

	return CooldownLabel.Visible
end

function AbilityService.StartCooldown(Button, Duration)
	if not Button or not Button.Parent then
		return
	end

	local Cooldown = Button:FindFirstChild("Cooldown")
	local CooldownLabel = Button:FindFirstChild("CooldownLabel")

	if not Cooldown or not CooldownLabel then
		return
	end

	Cooldown.Visible = true
	Cooldown.Size = UDim2.new(1, 0, 1, 0)
	CooldownLabel.Visible = true

	local Tween = TweenService:Create(
		Cooldown,
		TweenInfo.new(Duration, Enum.EasingStyle.Linear),
		{ Size = UDim2.new(1, 0, 0, 0) })
	Tween:Play()

	task.spawn(function()
		for TimeLeft = Duration, 0, -1 do
			if not Button or not Button.Parent then
				break
			end

			if CooldownLabel then
				CooldownLabel.Text = tostring(TimeLeft) .. "s"
			end

			task.wait(1)
		end

		if Button and Button.Parent and Cooldown and CooldownLabel then
			Cooldown.Visible = false
			Cooldown.Size = UDim2.new(1, 0, 1, 0)

			CooldownLabel.Visible = false
			CooldownLabel.Text = ""
		end
	end)
end

function AbilityService.UseAbility(AbilityName)
	local Button = AbilityService.GetAbilityButton(AbilityName)
	if not Button then
		return false
	end

	local Locked = Button:FindFirstChild("Locked")
	if Locked and Locked.Visible then
		return false
	end

	if AbilityService.IsAbilityOnCooldown(Button) then
		return false
	end

	local Success, Result, Cooldown = pcall(function()
		return UseEvent:InvokeServer(AbilityName)
	end)

	if not Success or not Result then
		return false
	end

	if Cooldown and tonumber(Cooldown) then
		AbilityService.StartCooldown(Button, tonumber(Cooldown))
	end
	return true
end

function AbilityService.BindAbility(AbilityName)
	local Button = AbilityService.GetAbilityButton(AbilityName)
	if not Button then
		return false
	end

	if Connections[AbilityName] then
		for i, Connection in pairs(Connections[AbilityName]) do
			if Connection then
				Connection:Disconnect()
			end
		end
	end

	Connections[AbilityName] = {}

	table.insert(
		Connections[AbilityName],
		Button.MouseButton1Click:Connect(function()
			AbilityService.UseAbility(AbilityName)
		end))

	local Keybind = Button:FindFirstChild("Input")
	if Keybind then
		table.insert(
			Connections[AbilityName],
			game:GetService("UserInputService").InputBegan:Connect(function(Input, GameProcessed)
				if GameProcessed then
					return
				end

				if Input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end
				
				if Input.KeyCode.Name == Keybind.Text then
					AbilityService.UseAbility(AbilityName)
				end
			end))
	end
	return true
end

function AbilityService.CreateAbility(AbilityName)
	if Connections[AbilityName] then
		return false
	end

	local Ability = AbilityService.ReturnAbilityInfo(AbilityName)
	if not Ability then
		return false
	end

	firesignal(CreateEvent.OnClientEvent, Ability, true)

	task.spawn(function()
		local Button
		for i = 1, 50 do
			Button = AbilityService.GetAbilityButton(AbilityName)
			if Button then
				break
			end
			task.wait(0.1)
		end

		if Button then
			AbilityService.BindAbility(AbilityName)
		end
	end)
	return true
end

return AbilityService
